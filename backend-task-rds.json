{
  "family": "ordering-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": ".dkr.ecr..amazonaws.com/ordering-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_HOST",
          "value": ""
        },
        {
          "name": "DB_USER",
          "value": "admin"
        },
        {
          "name": "DB_PASSWORD",
          "value": ""
        },
        {
          "name": "DB_NAME",
          "value": "ordering"
        }
      ]
    }
  ]
}
