{
  "family": "ordering-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::584560776132:role/ordering-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "584560776132.dkr.ecr.us-east-1.amazonaws.com/ordering-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
